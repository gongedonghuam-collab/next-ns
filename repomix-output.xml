    const ss = SpreadsheetApp.openById(MASTER_DB_ID);
    console.log("成功！スプレッドシート名: " + ss.getName());
    console.log("権限は正常です。");
  } catch (e) {
    console.error("エラー発生:", e.message);
    console.error("ConfigファイルのスプレッドシートIDを確認してください。");
  }
}
