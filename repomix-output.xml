      // Keyboard Navigation
      document.addEventListener("keydown", (e) => {
        const container = document.getElementById("container");
        if (e.key === "ArrowDown" || e.key === "ArrowRight" || e.key === " ") {
          e.preventDefault();
          container.scrollBy({ top: window.innerHeight, behavior: "smooth" });
